# Optional: Get a Brave key at https://brave.com/search/api/
# Without this, search falls back to DuckDuckGo (less reliable)
BRAVE_API_KEY=

# Optional: override defaults
# LLM_MODEL=qwen2.5:3b
# LLM_BASE_URL=http://localhost:11434
# LLM_MAX_TOKENS=4096
# SEARCH_NUM_RESULTS=6
# SEARCH_PROVIDER=brave
# Set SEARCH_PROVIDER=parallel for free Parallel Search MCP (no API key).
# Options: brave (default, with DDG fallback), duckduckgo, parallel
# AGENT_MAX_ITERATIONS=2
# AGENT_GAP_THRESHOLD=0.5
# RATE_LIMIT_REQUESTS=5
# RATE_LIMIT_WINDOW=60
# PORT=8000
